    "@ghostery/adblocker-playwright": ">=2.14.1",
    "@lightpanda/browser": ">=1.2.0",
    "camoufox": ">=0.5.8",
    "fingerprint-generator": ">=2.1.81",
    "fingerprint-injector": ">=2.1.81",
    "patchright": ">=1.58.0",
