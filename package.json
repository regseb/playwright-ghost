    "eslint-plugin-playwright": "2.12.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-regexp": "3.3.1",
    "eslint-plugin-security": "4.2.0",
    "eslint-plugin-unicorn": "78.0.0",
    "fingerprint-generator": "2.1.89",
    "fingerprint-injector": "2.1.89",
    "globals": "17.13.0",
    "jsr": "0.14.3",
    "markdownlint": "0.42.0",
    "metalint": "0.22.1",
    "npm-package-json-lint": "11.0.0",
    "patchright": "1.64.1",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "puppeteer": "25.14.0",
    "secretlint": "13.0.7",
    "typedoc": "0.28.20",
    "typescript": "6.0.3",
    "yaml-lint": "1.7.0"
  },
